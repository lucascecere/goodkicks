# Shopify Storefront API (same backend as Good Kicks)
SHOPIFY_STORE_DOMAIN=goodkicks.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Collections — towns live in the townies collection, Good Kicks (live sister
# line) in good-kicks. Adding a town = a new product in the townies collection.
SHOPIFY_TOWNIES_COLLECTION=townies
SHOPIFY_GOODKICKS_COLLECTION=good-kicks

# Site (goodkicks.co stays primary until the townies.shop cutover)
NEXT_PUBLIC_SITE_URL=https://goodkicks.co

# Two-brand URLs (used for cross-brand links + canonicals at cutover)
NEXT_PUBLIC_TOWNIES_URL=https://townies.shop
NEXT_PUBLIC_GOODKICKS_URL=https://goodkicks.co

# When "true", goodkicks.co is host-rewritten to the /goodkicks section (option B).
# Leave empty/false until the townies.shop cutover — goodkicks.co is still live prod.
ENABLE_GK_HOST_REWRITE=

# Contact form (optional — leave RESEND_API_KEY empty to log only)
CONTACT_EMAIL=hello@townies.shop
RESEND_API_KEY=

# Signs admin session cookies. Any long random string (openssl rand -hex 48).
# Falls back to ADMIN_PASSWORD when unset; setting it means changing the admin
# password no longer logs everyone out.
ADMIN_SESSION_SECRET=

# Shopify order webhook → contacts (app/api/webhooks/shopify/orders).
# Shopify admin → Settings → Notifications → Webhooks → "Order creation",
# JSON, URL https://townies.shop/api/webhooks/shopify/orders. The signing
# secret is shown at the bottom of that page. Empty = the route rejects
# everything, which is the right default for a public endpoint.
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Content Studio (/admin/studio)
#
# ALL OPTIONAL. Every template renders on mock data with this whole block
# empty — keys only switch on auto-fill from live feeds.
# ---------------------------------------------------------------------------

# Betting lines, from the-odds-api.com. Empty = odds modules stay hidden.
THE_ODDS_API_KEY=

# Which backend answers schedule/score lookups. "espn" is keyless and covers
# MLB, NHL, NBA and NFL. Leave unset unless swapping to a paid provider.
STUDIO_SPORTS_PROVIDER=

# Schedules, scores and MLB probable pitchers need no key at all —
# statsapi.mlb.com and ESPN's public endpoints are both open.
